// CloudFront Function (viewer-request) that optionally:
//   - redirects `www.<domain>` to the apex domain (`redirect_www = true`)
//   - maps extension-less URIs to `.html` files (`clean_urls.enabled = true`)
// Rendered by Terraform:
//   `redirect_www` is true when www requests are answered with a 301 to `https://${apex_domain}`.
//   `clean_urls` is true when `clean_urls.enabled = true`.
//   `redirect` is true for `clean_urls.mode = "redirect"`.

function handler(event) {
  var request = event.request;
  var uri = request.uri;

%{ if redirect_www ~}
  // Redirect before any rewriting so the original path and query string are preserved.
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : '';
  if (host === 'www.${apex_domain}') {
    return movedPermanently('https://${apex_domain}' + uri + buildQueryString(request.querystring));
  }

%{ endif ~}
%{ if clean_urls ~}
  // `/` is handled by the distribution's default_root_object.
  if (uri === '/') {
    return request;
  }

  // Directory-style path: always rewrite, `/docs/` is a legitimate canonical URL.
  if (uri.endsWith('/')) {
    request.uri = uri + 'index.html';
    return request;
  }

  // Anything with an extension in its last segment is a real file; leave it alone.
  var lastSegment = uri.substring(uri.lastIndexOf('/') + 1);
  if (lastSegment.indexOf('.') !== -1) {
    return request;
  }

  var target = uri + '.html';

  if (!${redirect}) {
    request.uri = target;
    return request;
  }

  return movedPermanently(target + buildQueryString(request.querystring));
%{ else ~}
  return request;
%{ endif ~}
}

function movedPermanently(location) {
  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: {
      location: { value: location }
    }
  };
}

function buildQueryString(qs) {
  var parts = [];
  for (var key in qs) {
    var entry = qs[key];
    if (entry.multiValue) {
      for (var i = 0; i < entry.multiValue.length; i++) {
        parts.push(key + '=' + entry.multiValue[i].value);
      }
    } else {
      parts.push(entry.value === '' ? key : key + '=' + entry.value);
    }
  }
  return parts.length ? '?' + parts.join('&') : '';
}
